# Agentic AI Software Company - environment template
# Copy this file to `.env` and adapt it to your environment.
# Never commit real secrets to GitHub.

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# Examples:
#   ollama             -> local Ollama installation
#   openai_compatible  -> OpenAI-compatible endpoint, e.g. HAW ICC
#   google             -> Google AI Studio (Gemini 1.5/2.0 Flash)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b

# When Python/FastAPI runs directly on the host:
LLM_BASE_URL=http://localhost:11434

# If the application runs inside Docker while Ollama runs natively on
# macOS/Windows, use instead:
# LLM_BASE_URL=http://host.docker.internal:11434
#
# For HAW ICC, replace this with the provided API base URL.
# For Google AI Studio (LLM_PROVIDER=google, LLM_MODEL=gemini-1.5-flash),
# you can provide GEMINI_API_KEY, GOOGLE_API_KEY, or LLM_API_KEY below:
LLM_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=768

# -----------------------------------------------------------------------------
# Embeddings / RAG
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
# POSTGRES_DB/USER/PASSWORD provision the `db` container via Docker Compose
# variable substitution (see docker-compose.yml) and must match the
# credentials embedded in DATABASE_URL / LANGCHAIN_POSTGRES_URL below.
POSTGRES_DB=agentic_company
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_dev_only

# Used directly by src/app/db.py via psycopg.connect() - plain "postgresql://"
# scheme, no SQLAlchemy dialect suffix.
DATABASE_URL=postgresql://agentic:agentic_dev_only@localhost:5432/agentic_company

# Used by src/rag/vectorstore.py (langchain-postgres, SQLAlchemy-style) - same
# credentials as above, "postgresql+psycopg://" scheme.
LANGCHAIN_POSTGRES_URL=postgresql+psycopg://agentic:agentic_dev_only@localhost:5432/agentic_company

# If FastAPI runs inside Docker Compose and PostgreSQL is the service `db`,
# replace `localhost` with `db` in both URLs above.

# -----------------------------------------------------------------------------
# Local tracing / cost engineering
# -----------------------------------------------------------------------------
# RUN_ID is replaced with the run identifier; legacy literal paths still append.
TRACE_FILE=logs/RUN_ID.jsonl
COST_CALL_BASE_CREDITS=1.0
COST_RUNTIME_CREDITS_PER_SECOND=0.01
COST_INPUT_CREDITS_PER_1K_TOKENS=0.02
COST_OUTPUT_CREDITS_PER_1K_TOKENS=0.04

# -----------------------------------------------------------------------------
# Optional LangSmith tracing
# -----------------------------------------------------------------------------
# LangSmith is optional and does not replace local repository-based traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-course

# Optional endpoint override:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
